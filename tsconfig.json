{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": "./src/widgets",
    "paths": {
      "modules/*": ["modules/*"],
      "assets/*": ["assets/*"],
      "components/*": ["components/*"],
      "context/*": ["context/*"],
      "hooks/*": ["hooks/*"],
      "constants/*": ["constants/*"],
      "utils/*": ["utils/*"],
      "types/*": ["types/*"],
      "test/*": ["_test/*"],
      "data": ["data/index.ts"]
    },
    "types": ["vitest/globals", "vite/client"],

    /* Bundler mode */
    "moduleResolution": "node",
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Declaration generation */
    "noEmit": false,
    "declaration": true,
    "esModuleInterop": true,
    "outDir": "dist",

    /* JSX handling */
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/widgets/types/svg.d.ts",
    "vite.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tsconfig.json"
  ]
}
